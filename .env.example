# Valores obtidos em Firebase Console > Configurações do projeto > Seus aplicativos > Web
# Este exemplo NÃO funciona até você colocar os valores do seu projeto.
EXPO_PUBLIC_FIREBASE_API_KEY=SUA_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=SEU_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=SEU_APP_ID
